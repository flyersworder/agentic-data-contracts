        "expression": "SUM(orders.amount)"
       }
      ]
     },
     "name": "amount_default_expr"
    },
    {
     "description": "",
     "expression": {
      "dialects": [
       {
        "dialect": "ANSI_SQL",
        "expression": "PERCENTILE_CONT(0.9) WITHIN GROUP (ORDER BY orders.amount)"
       }
      ]
     },
     "name": "p90_order"
    },
    {
     "description": "",
