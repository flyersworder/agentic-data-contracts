      "dialects": [
       {
        "dialect": "ANSI_SQL",
        "expression": "AVG(orders.amount)"
       }
      ]
     },
     "name": "average_order"
    },
    {
     "description": "",
     "expression": {
      "dialects": [
       {
        "dialect": "ANSI_SQL",
        "expression": "MAX(orders.amount)"
       }
      ]
     },
     "name": "largest_order"
    },
    {
     "description": "",
     "expression": {
      "dialects": [
       {
        "dialect": "ANSI_SQL",
