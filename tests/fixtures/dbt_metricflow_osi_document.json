   "metrics": [
    {
     "description": "Sum of order amounts",
     "expression": {
      "dialects": [
       {
        "dialect": "ANSI_SQL",
        "expression": "SUM(orders.amount)"
       }
      ]
     },
     "name": "revenue"
    },
    {
     "description": "",
     "expression": {
      "dialects": [
       {
        "dialect": "ANSI_SQL",
        "expression": "SUM(CASE WHEN orders.order_id IS NOT NULL THEN 1 ELSE 0 END)"
       }
      ]
     },
     "name": "orders_placed"
    },
    {
     "description": "",
     "expression": {
      "dialects": [
       {
        "dialect": "ANSI_SQL",
        "expression": "COUNT(DISTINCT orders.customer_id)"
       }
      ]
     },
     "name": "customers_ordering"
    },
