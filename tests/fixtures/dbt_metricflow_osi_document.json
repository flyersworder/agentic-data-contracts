     "expression": {
      "dialects": [
       {
        "dialect": "ANSI_SQL",
        "expression": "SUM(CASE WHEN order__status = 'completed' THEN orders.amount END)"
       }
      ]
     },
     "name": "completed_revenue"
    },
    {
     "description": "",
     "expression": {
      "dialects": [
       {
        "dialect": "ANSI_SQL",
        "expression": "SUM(CASE WHEN order__status = 'completed' THEN CASE WHEN orders.order_id IS NOT NULL THEN 1 ELSE 0 END END)"
       }
      ]
     },
     "name": "completed_orders"
    },
    {
     "description": "",
     "expression": {
      "dialects": [
       {
        "dialect": "ANSI_SQL",
        "expression": "SUM(CASE WHEN (order__is_large = true) AND (order__status = 'completed') THEN CASE WHEN is_paid THEN 1 ELSE 0 END END)"
       }
      ]
     },
     "name": "large_paid_orders"
    },
    {
     "description": "",
     "expression": {
      "dialects": [
       {
        "dialect": "ANSI_SQL",
        "expression": "SUM(CASE WHEN customer__region = 'EU' THEN orders.amount END)"
       }
      ]
     },
     "name": "eu_revenue"
    },
    {
     "description": "",
     "expression": {
      "dialects": [
       {
        "dialect": "ANSI_SQL",
        "expression": "SUM(CASE WHEN order__ordered_at__month = '2026-01-01' THEN orders.amount END)"
       }
      ]
     },
     "name": "jan_revenue"
    },
    {
     "description": "",
     "expression": {
      "dialects": [
       {
        "dialect": "ANSI_SQL",
        "expression": "(SUM(orders.amount)) / (SUM(CASE WHEN orders.order_id IS NOT NULL THEN 1 ELSE 0 END))"
       }
      ]
     },
     "name": "order_value"
    },
    {
     "description": "",
     "expression": {
      "dialects": [
       {
        "dialect": "ANSI_SQL",
        "expression": "SUM(orders.amount) - MAX(orders.amount)"
       }
      ]
     },
     "name": "revenue_less_largest"
    },
    {
     "description": "",
     "expression": {
      "dialects": [
       {
        "dialect": "ANSI_SQL",
        "expression": "SUM(orders.amount)"
       }
      ]
     },
