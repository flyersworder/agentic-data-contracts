    {
     "description": "",
     "expression": {
      "dialects": [
       {
        "dialect": "ANSI_SQL",
        "expression": "SUM(CASE WHEN order__ordered_at >= '2026-01-15' THEN CASE WHEN orders.order_id IS NOT NULL THEN 1 ELSE 0 END END)"
       }
      ]
     },
     "name": "orders_since_mid_jan"
    },
